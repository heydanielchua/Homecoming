__pycache__/
*.pyc
.venv/
.pytest_cache/
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/cache/
# Belt and braces for the cache directory above. The URA land use layer is
# 174 MB and GitHub refuses a push carrying anything over 100, so a stray
# download must never be committable even if it lands in the wrong place.
data/*.geojson
data/*.json
.env
*.egg-info/

# The built site. `scripts/build_site.sh` makes it; committing a rebuilt
# database and its JSON every month would grow the repository for ever.
dist/
web/node_modules/
